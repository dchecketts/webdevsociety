---
import Image from 'astro/components/Image.astro'
import '../../styles/navigation.css'
const BASE_URL = import.meta.env.BASE_URL;
---

<header>
    <nav class="bg-blue-950 p-5">
        <ul class="flex justify-center md:justify-between mx-10">
            <li class="hidden md:block">
                <a href=`${BASE_URL}`>
                    <Image src=`${BASE_URL}/images/whitelogo.svg` alt="WDD Society" width={85} height={85} loading="eager" />
                </a>
            </li>
            <li class="flex items-center justify-center">
                <ul class="text-white gap-5 flex items-center">
                    <li><a href=`${BASE_URL}` class="hover:bg-white hover:text-blue-950 px-2 py-1 rounded-sm">Home</a></li>
                    <li><a href=`${BASE_URL}/members` class="hover:bg-white hover:text-blue-950 px-2 py-1 rounded-sm">Members</a></li>
                    <li><a href=`${BASE_URL}/projects` class="hover:bg-white hover:text-blue-950 px-2 py-1 rounded-sm">Projects</a></li>
                    <li><a href=`${BASE_URL}/events` class="hover:bg-white hover:text-blue-950 px-2 py-1 rounded-sm">Events</a></li>
                </ul>
            </li>
        </ul>
    </nav>
</header>
