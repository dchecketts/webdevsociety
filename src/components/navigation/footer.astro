---
import '../../styles/navigation.css'

const year = new Date().getFullYear();

import variables from '../../assets/data/variables.json'

---

<!-- gap-3 pt-5 pb-10 -->
<footer class="bg-blue-950 text-white flex flex-col items-center py-5 gap-2">
    <span>&copy; {year} BYU-I Web Dev Society</span>
    <div class="flex flex-col items-center md:flex-row md:divide-x md:divide-white">
        <!-- Join us {time} {day} at {room} -->
        <span class="md:pr-1">{variables.room}</span>
        <span class="pl-1">{variables.day} {variables.time}</span>
    </div>
</footer>
