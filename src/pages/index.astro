---
import '../styles/global.css';
import BasicLayout from '../layouts/sitelayout.astro';
import heroImage from '../assets/images/hero-banner.jpg';
import variables from '../assets/data/variables.json'

const BASE_URL = import.meta.env.BASE_URL;
---

<BasicLayout>
	<section
		id="hero-banner"
		style={`--hero-bg: url(${heroImage.src})`}
		class="bg-black bg-[linear-gradient(hsl(0_0%_0%/0.5)),var(--hero-bg)] bg-cover bg-center h-96 w-full flex"
	>
		<div class="md:w-1/4 px-5 md:px-0 md:pl-10 pb-5 flex flex-col-reverse">
			<div class="bg-gray-50 dark:bg-gray-900 rounded-sm h-fit p-5 shadow-md flex flex-col gap-3">
				<span class="text-bold text-2xl text-center md:text-left">Build Websites</span>
				<p>Improve your skills. Build personal websites to showcase yourself and your projects. Learn new technologies and develop alongside your peers.</p>
				<a href=`${BASE_URL}/members` class="bg-blue-950 text-white hover:bg-gray-800 rounded-full px-3 py-2 self-center">Meet the Society</a>
			</div>
		</div>
		<div class="md:w-3/4"></div>
	</section>

	<section id="quote" class="bg-blue-950 text-white py-3">
		<div class="w-fit mx-auto flex flex-col md:flex-row items-center gap-3">
			<span class="font-bold text-center">"Increase your focus on those things that really matter."</span>
			<span>- Alvin F. Meredith III</span>
		</div>
	</section>

	<section id="about" class="flex flex-col md:flex-row py-10 md:px-20">
		<div id="presidency-message" class="mx-auto md:mx-none w-2/3 flex flex-col gap-10 items-center justify-center">
			<span class="font-light text-5xl text-center">Mission Statement</span>
			<div class="md:w-1/2 text-justify flex flex-col gap-3 mx-auto">
				<p>The BYU-I Web Design and Development Society is dedicated to fostering a vibrant and collaborative community for students passionate about creating digital experiences.</p>
				<p>Our mission is to spark interest in web development by providing hands-on learning opportunities, promoting innovative design, and connecting members with real-world industry insights.</p>
				<p>Through workshops, projects, and mentorship, we empower students to develop their skills, explore creative solutions, and prepare for successful careers in web development. Together, we aim to inspire the next generation of web creators.</p>

			</div>
		</div>

		<div class="md:w-1/3 flex flex-col items-center gap-5 pt-15 md:py-0">

			<div id="society-info" class="bg-blue-950 text-white rounded-sm p-5 w-3/4">
				<span class="font-bold">Information</span>
				<ul class="list-disc pl-5">
					<li><span class="font-bold">Where:</span> {variables.room}</li>
					<li><span class="font-bold">When:</span> {variables.day} {variables.time}</li>
				</ul>
			</div>

			<div id="values" class="bg-blue-950 text-white rounded-sm p-5 w-3/4">
				<span class="font-bold">Our Values</span>
				<ul class="list-disc pl-5">
					<li>Creativity</li>
					<li>Connection</li>
					<li>Accessibility</li>
					<li>Innovative Design</li>
				</ul>
			</div>
			<div id="goals" class="bg-blue-950 text-white rounded-sm p-5 w-3/4">
				<span class="font-bold">Our Goals</span>
				<ul class="list-disc pl-5">
					<li>Hands-On Practice</li>
					<li>Develop Personal Networks</li>
					<li>Learn from Professionals</li>
					<li>Build Resumes</li>
				</ul>
			</div>
		</div>
	</section>
</BasicLayout>
